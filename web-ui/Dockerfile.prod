# syntax=docker/dockerfile:1.7
FROM node:20.19.5-bookworm-slim@sha256:9e70124bd00f47dd023e349cd587132ae61892acc0e47ed641416c3e18f401c3 AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY .docker-certs/ /tmp/npm-extra-certs/

ENV NODE_ENV=development \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_FETCH_RETRIES=6 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=180000 \
    NPM_CONFIG_FETCH_TIMEOUT=600000 \
    NPM_CONFIG_MAXSOCKETS=5

RUN --mount=type=cache,target=/root/.npm \
    set -eux; \
    extra_ca=/tmp/npm-extra-ca.pem; \
    find /tmp/npm-extra-certs -type f \( -name '*.pem' -o -name '*.crt' \) -exec cat {} \; > "$extra_ca"; \
    if [ -s "$extra_ca" ]; then \
      export NODE_EXTRA_CA_CERTS="$extra_ca"; \
      echo "Using local extra CA certificates for npm TLS verification."; \
    fi; \
    npm ci --include=dev; \
    test -x node_modules/.bin/tsc; \
    test -x node_modules/.bin/vite

COPY . .

ARG VITE_API_BASE_URL=/stock
ARG VITE_LLM_HOST_URL=/llm
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_LLM_HOST_URL=$VITE_LLM_HOST_URL

RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

RUN sed -i 's#pid[[:space:]].*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && rm -f /etc/nginx/conf.d/default.conf \
    && chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html /etc/nginx/conf.d

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# auth_request is required by nginx.prod.conf. Static upstream names only exist
# on the Compose network, so full nginx -t validation occurs at container start.
RUN chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/conf.d/default.conf \
    && nginx -V 2>&1 | grep -q -- '--with-http_auth_request_module'

USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx", "-g", "daemon off;"]
