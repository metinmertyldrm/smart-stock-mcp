# Docker Compose defaults. Copy this file to .env before customizing.

DB_USERNAME=postgres
DB_PASSWORD=postgres
# Host port 5433 avoids colliding with a normal local PostgreSQL on 5432.
POSTGRES_PORT=5433

STOCK_SERVICE_PORT=8081
LLM_HOST_PORT=8000
WEB_UI_PORT=5173
OLLAMA_PORT=11434
ACCEPTANCE_SERVICE_PORT=8082

OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
# OLLAMA_IMAGE=ollama/ollama:latest

CORS_ALLOWED_ORIGINS=http://localhost:5173
LLM_CORS_ALLOWED_ORIGINS=http://localhost:5173

# These values are compiled into the Vite production bundle at image build time.
# If you expose the services on different host ports/hosts, update them and rebuild web-ui.
VITE_API_BASE_URL=http://localhost:8081
VITE_LLM_HOST_URL=http://localhost:8000
